<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_16">

    <TextView
        android:id="@+id/tvPageLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance_Lumora_SectionTitle"
        android:textSize="14sp"
        android:textColor="?attr/colorPrimary"
        tools:text="Page 1" />

    <TextView
        android:id="@+id/tvPageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:lineSpacingExtra="4dp"
        android:textIsSelectable="true"
        android:textAppearance="@style/TextAppearance_Lumora_Body"
        tools:text="Extracted text for this page..." />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:background="?attr/colorOutlineVariant" />

</LinearLayout>
