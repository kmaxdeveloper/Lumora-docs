<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingTop="@dimen/spacing_24"
        android:paddingBottom="@dimen/spacing_32">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance_Lumora_Hero"
            android:textColor="?attr/colorPrimary"
            android:letterSpacing="-0.02"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/scanner_desc_settings"
            android:src="@drawable/ic_settings"
            app:layout_constraintBottom_toBottomOf="@id/tvAppName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvAppName"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_40"
            android:text="@string/home_greeting_morning"
            android:textAppearance="@style/TextAppearance_Lumora_ScreenTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppName" />

        <TextView
            android:id="@+id/tvSubGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/home_sub_greeting"
            android:textAppearance="@style/TextAppearance_Lumora_BodySecondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_28"
            app:cardCornerRadius="@dimen/radius_extra_large"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeWidth="0dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/tvSubGreeting">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_scan_hero_gradient"
                android:padding="@dimen/spacing_24">

                <TextView
                    android:id="@+id/tvScanTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/home_scan_title"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    app:layout_constraintEnd_toStartOf="@id/ivScanIcon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:text="@string/home_scan_desc"
                    android:textAppearance="@style/TextAppearance_Lumora_BodySecondary"
                    android:textColor="@color/white"
                    android:alpha="0.8"
                    app:layout_constraintEnd_toStartOf="@id/ivScanIcon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvScanTitle" />

                <ImageView
                    android:id="@+id/ivScanIcon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_scan"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:background="@drawable/bg_page_indicator"
                    android:backgroundTint="#26FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImport"
            style="@style/Widget_Lumora_Button_Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/home_btn_import"
            app:icon="@drawable/ic_gallery"
            app:iconTint="?attr/colorPrimary"
            app:layout_constraintTop_toBottomOf="@id/cardScan" />

        <TextView
            android:id="@+id/tvRecentDocsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_40"
            android:text="@string/home_recent_header"
            android:textAppearance="@style/TextAppearance_Lumora_SectionTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnImport" />

        <TextView
            android:id="@+id/btnSeeAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/home_btn_see_all"
            android:textAppearance="@style/TextAppearance_Lumora_Button"
            android:textColor="?attr/colorPrimary"
            android:paddingHorizontal="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="@id/tvRecentDocsHeader"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvRecentDocsHeader" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentDocuments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/tvRecentDocsHeader"
            tools:listitem="@layout/item_document"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_32"
            android:background="@drawable/bg_empty_state_minimal"
            app:layout_constraintTop_toBottomOf="@id/tvRecentDocsHeader">

            <ImageView
                android:layout_width="@dimen/spacing_48"
                android:layout_height="@dimen/spacing_48"
                android:src="@drawable/ic_empty_docs"
                android:contentDescription="@null"
                app:tint="?attr/colorOnSurfaceVariant"
                android:alpha="0.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/home_empty_title"
                android:textAppearance="@style/TextAppearance_Lumora_SectionTitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:gravity="center"
                android:text="@string/home_empty_desc"
                android:textAppearance="@style/TextAppearance_Lumora_Caption"
                android:alpha="0.8" />
        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierRecentDocs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="rvRecentDocuments,layoutEmptyState" />

        <!-- Banner Ad Container (Hidden if No-Ads / Premium) -->
        <FrameLayout
            android:id="@+id/adBannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_32"
            android:layout_marginBottom="@dimen/spacing_16"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/barrierRecentDocs"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
