<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <uz.kmax.documents.ui.DocumentDetectionOverlay
        android:id="@+id/detectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Stability / Status Message -->
    <TextView
        android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:text="@string/scanner_status_hold"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite"
            app:layout_constraintBottom_toTopOf="@id/layoutBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible" />

    <!-- Visual Guide for Document -->
    <View
        android:id="@+id/viewGuide"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="48dp"
        android:background="@drawable/bg_scanner_guide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1.414"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4" />

    <!-- Top Controls -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_16"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/scanner_close_desc"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/btnFlash"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/scanner_flash_desc"
        android:src="@drawable/ic_flash_off"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white" />

    <!-- Bottom Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/scrim"
        android:paddingVertical="@dimen/spacing_24"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/btnCapture"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_shutter_button"
            android:contentDescription="@string/scanner_desc_capture"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/scanner_option_gallery"
            android:src="@drawable/ic_gallery"
            app:layout_constraintBottom_toBottomOf="@id/btnCapture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnCapture"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvPageCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_24"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance_Lumora_Caption"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@null"
            android:contentDescription="@string/review_header_pages"
            app:layout_constraintBottom_toBottomOf="@id/btnCapture"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnCapture"
            tools:text="3"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Permission Denial State (Overlay) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPermission"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:id="@+id/ivPermission"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_scan"
            android:contentDescription="@null"
            app:layout_constraintBottom_toTopOf="@id/tvPermissionTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tvPermissionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/scanner_permission_title"
            android:textAppearance="@style/TextAppearance_Lumora_ScreenTitle"
            app:layout_constraintBottom_toTopOf="@id/tvPermissionDesc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivPermission" />

        <TextView
            android:id="@+id/tvPermissionDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/scanner_permission_desc"
            android:textAppearance="@style/TextAppearance_Lumora_BodySecondary"
            app:layout_constraintBottom_toTopOf="@id/btnRequestPermission"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPermissionTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestPermission"
            style="@style/Widget_Lumora_Button_Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/scanner_btn_allow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPermissionDesc" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
